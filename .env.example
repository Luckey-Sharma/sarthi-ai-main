# Google Gemini API Key (REQUIRED for online AI companion)
# Replace with your actual Gemini API key for server-side Sarthi assistance
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search API (OPTIONAL — enables Google Custom Search)
# If not provided, Sarthi automatically uses built-in DuckDuckGo Lite search (zero-config, no API key needed).
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_custom_search_engine_id_here
